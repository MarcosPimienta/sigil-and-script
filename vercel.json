{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/invite/:token",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(whatsapp|WhatsApp|facebookexternalhit|twitterbot|telegrambot|slackbot|linkedinbot|applebot|discordbot|bingbot|googlebot).*"
        }
      ],
      "destination": "/api/invite?token=:token"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
