# Database (Prisma, PostgreSQL). For local dev with SQLite change the provider in prisma/schema.prisma.
DATABASE_URL="postgresql://user:password@localhost:5432/sigil"
DIRECT_URL="postgresql://user:password@localhost:5432/sigil"

# Password recovery emails (Resend). Leave RESEND_API_KEY unset locally: the
# reset link is then printed to the server console instead of being emailed.
RESEND_API_KEY=""
MAIL_FROM="Sigil & Script <noreply@yourdomain.com>"

# Frontend origin used to build links in emails
APP_URL="http://localhost:5173"
