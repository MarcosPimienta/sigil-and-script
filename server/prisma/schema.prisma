datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model InvitationCanvas {
  id              String   @id @default(uuid())
  /** WEDDING | BIRTHDAY | BAPTISM | CORPORATE | CUSTOM (legacy rows default to WEDDING) */
  eventType       String   @default("WEDDING")
  envelopeColor   String
  waxSealAsset    String
  musicUrl        String?
  countdownTarget String
  colorPalette    String   // Store array as JSON string
  itinerary       String   // Store array of objects as JSON string
  hostId          String
  designData      String   @default("{}")
  invitees        Guest[]
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
}

model User {
  id        String             @id @default(uuid())
  email     String             @unique
  password  String // Store hashed password (with salt)
  name      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  canvases    InvitationCanvas[]
  sessions    Session[]
  resetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique // sha256 of the emailed token; plaintext is never stored
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Guest {
  id               String            @id @default(uuid())
  name             String
  language         String            @default("ES") // ES | EN
  guestType        String            @default("INDIVIDUAL") // INDIVIDUAL | FAMILY
  allottedSeats    Int               @default(1)
  confirmedSeats   Int               @default(0)
  status           String            @default("PENDING") // PENDING | OPENED | CONFIRMED | DECLINED
  openedTimestamp  String?           // Stored as ISO-8601 string
  formResponses    String            @default("{}") // Store record<string, any> as JSON string
  canvasId         String
  canvas           InvitationCanvas  @relation(fields: [canvasId], references: [id])
}
